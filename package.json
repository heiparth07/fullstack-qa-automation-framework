{
  "name": "sdet-portfolio-project",
  "version": "1.0.0",
  "description": "Full-stack QA/SDET test automation framework with CI/CD, Docker, and multi-layer testing",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "tests"
  ],
  "scripts": {
    "dev:backend": "npm -w backend run dev",
    "dev:frontend": "npm -w frontend run dev",
    "build": "npm -w backend run build && npm -w frontend run build",
    "test:api": "npm -w tests run test:api",
    "test:ui": "npm -w tests run test:ui",
    "test:perf": "npm -w tests run test:perf",
    "test:security": "npm -w tests run test:security",
    "test:all": "npm -w tests run test:all",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:test": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.test.yml up --abort-on-container-exit"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
